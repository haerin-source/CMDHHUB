-- Stun Mon: once HP < threshold% of max → set 0
----------------------------------------------------------------
local stunMon = false
local stunThreshold = 0.99 -- slider: percent of MaxHealth
local stunConn = nil
local stunHooked = setmetatable({}, { __mode = "k" })

local function stunAttach(model)
    if not model or not model:IsA("Model") then return end
    if Players:GetPlayerFromCharacter(model) then return end
    if stunHooked[model] then return end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    stunHooked[model] = true
    hum:GetPropertyChangedSignal("Health"):Connect(function()
        if not stunMon or unloaded then return end
        if hum.Health > 0 and hum.MaxHealth > 0
            and hum.Health < (hum.MaxHealth * stunThreshold) then
            hum.Health = 0
        end
    end)
    if stunMon and hum.Health > 0 and hum.MaxHealth > 0
        and hum.Health < (hum.MaxHealth * stunThreshold) then
        hum.Health = 0
    end
end

local function stunScanAll()
    local living = Workspace:FindFirstChild("Living") or workspace:FindFirstChild("Living")
    if not living then return end
    for _, model in ipairs(living:GetChildren()) do
        stunAttach(model)
    end
    if stunConn then pcall(function() stunConn:Disconnect() end) end
    stunConn = living.ChildAdded:Connect(function(child)
        task.wait(0.2)
        if stunMon and not unloaded then stunAttach(child) end
    end)
end

