-- Mob Aimbot: nearest living NPC + outline, clean OFF
----------------------------------------------------------------
local Camera = workspace.CurrentCamera
local mobAimOn = false
local aimHighlight = nil
local aimTarget = nil
local aimConn = nil

local function clearAimVisual()
    if aimHighlight then
        pcall(function() aimHighlight:Destroy() end)
        aimHighlight = nil
    end
    aimTarget = nil
end

local function setAimOutline(model)
    if aimTarget == model and aimHighlight and aimHighlight.Parent then
        return
    end
    clearAimVisual()
    if not model then return end
    local h = Instance.new("Highlight")
    h.Name = "MobAimOutline"
    h.Adornee = model
    h.FillTransparency = 1
    h.OutlineTransparency = 0
    h.OutlineColor = Color3.fromRGB(0, 255, 120)
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = model
    aimHighlight = h
    aimTarget = model
end

local function isLivingMob(model)
    if not model or not model:IsA("Model") or not model.Parent then return false end
    if Players:GetPlayerFromCharacter(model) then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return false end
    if hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead then return false end
    return true
end

local function nearestLivingMob()
    local living = Workspace:FindFirstChild("Living") or workspace:FindFirstChild("Living")
    local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    if not living or not hrp then return nil end
    local best, bestD = nil, math.huge
    for _, m in ipairs(living:GetChildren()) do
        if isLivingMob(m) then
            local root = m:FindFirstChild("HumanoidRootPart")
            local d = (hrp.Position - root.Position).Magnitude
            if d < bestD then
                best, bestD = m, d
            end
        end
    end
    return best
end

local function stopMobAim()
    mobAimOn = false
    if aimConn then
        pcall(function() aimConn:Disconnect() end)
        aimConn = nil
    end
    clearAimVisual()
end

local function startMobAim()
    stopMobAim()
    mobAimOn = true
    aimConn = RunService.RenderStepped:Connect(function()
        if not mobAimOn or unloaded then
            stopMobAim()
            return
        end
        local cam = workspace.CurrentCamera
        if not cam then return end
        local target = nearestLivingMob()
        if not target then
            clearAimVisual()
            return
        end
        local root = target:FindFirstChild("HumanoidRootPart")
        local head = target:FindFirstChild("Head")
        local aimPart = head or root
        if not aimPart then
            clearAimVisual()
            return
        end
        setAimOutline(target)
        local look = aimPart.Position
        cam.CFrame = CFrame.new(cam.CFrame.Position, look)
    end)
end

MobFarmGroup:AddToggle("MobAimbot", {
    Text = "Mob Aimbot",
    Default = false,
    Callback = function(v)
        if v then
            startMobAim()
            notify("Aim", "ON | nearest living")
        else
            stopMobAim()
            notify("Aim", "OFF")
        end
    end,
})
