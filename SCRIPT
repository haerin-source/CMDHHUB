local playerEspWanted = false
local function wipePlayerESP()
    -- hub table clear
    pcall(function()
        if _G.PlayerEspAPI and _G.PlayerEspAPI.SetEnabled then
            _G.PlayerEspAPI.SetEnabled(false)
        end
    end)
    -- hard wipe every PLAYER_ESP left in game
    for _, plr in ipairs(Players:GetPlayers()) do
        local char = plr.Character
        if char then
            for _, d in ipairs(char:GetDescendants()) do
                if d.Name == "PLAYER_ESP" then
                    pcall(function() d:Destroy() end)
                end
            end
            local direct = char:FindFirstChild("PLAYER_ESP")
            if direct then pcall(function() direct:Destroy() end) end
        end
    end
    for _, d in ipairs(workspace:GetDescendants()) do
        if d.Name == "PLAYER_ESP" then
            pcall(function() d:Destroy() end)
        end
    end
end

