local spiderOn = false
local spiderConn, spiderBv
local function setSpider(on)
    spiderOn = on and true or false
    if spiderConn then pcall(function() spiderConn:Disconnect() end) spiderConn = nil end
    if spiderBv then pcall(function() spiderBv:Destroy() end) spiderBv = nil end
    if not spiderOn then return end
    spiderConn = RunService.Heartbeat:Connect(function()
        if unloaded or not spiderOn then return end
        local char = Player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { char }
        local hit = workspace:Raycast(root.Position, root.CFrame.LookVector * 2.2, params)
        if hit then
            if not spiderBv or not spiderBv.Parent then
                local bv = Instance.new("BodyVelocity")
                bv.Name = "CMDH_SpiderBV"
                bv.MaxForce = Vector3.new(0, 1e5, 0)
                bv.Velocity = Vector3.new(0, 28, 0)
                bv.Parent = root
                spiderBv = bv
            else
                spiderBv.Velocity = Vector3.new(0, 28, 0)
            end
        else
            if spiderBv then pcall(function() spiderBv:Destroy() end) spiderBv = nil end
        end
    end)
end

