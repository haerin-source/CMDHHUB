local function farmOne(model)
    local hrp = model:FindFirstChild("HumanoidRootPart")
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    local function farmGate()
        return farmToggle or raidFarmOn or specterFarmOn or allFiendFarmOn
    end
    spiderActive = true
    while farmGate() and hum.Parent and hum.Health > 0 do
        if not farmGate() then break end
        if not isMobOnGround(hrp) then break end
        approachMob(hrp)
        -- OFF during approach → leave immediately, no face/attack/snap
        if not farmGate() then break end
        local my = select(1, getHRP())
        if my and hrp.Parent and farmGate() then
            pcall(function()
                local look = hrp.Position
                if not isZombieDevil(hrp) then
                    look = Vector3.new(hrp.Position.X, my.Position.Y, hrp.Position.Z)
                end
                my.CFrame = faceAt(my, my.Position, look)
            end)
        end
        if not farmGate() then break end
        doAttack()
        task.wait(0.05)
    end
    spiderActive = false
end

local function pickPriorityTarget()
    local living = workspace:FindFirstChild("Living")
    local myHrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    if not living or #selectedMobs == 0 then return nil end
    -- priority name first; within same name pick nearest
    for _, mobName in ipairs(selectedMobs) do
        local best, bestD = nil, math.huge
        for _, child in ipairs(living:GetChildren()) do
            if child.Name == mobName and not isPlayerChar(child) then
                local hum = child:FindFirstChildOfClass("Humanoid")
                local root = child:FindFirstChild("HumanoidRootPart")
                if hum and root and hum.Health > 0 and isMobOnGround(root) then
                    local d = 0
                    if myHrp then
                        d = (myHrp.Position - root.Position).Magnitude
                    end
                    if d < bestD then
                        best, bestD = child, d
                    end
                end
            end
        end
        if best then return best end
    end
    return nil
end

