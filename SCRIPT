local noclipEnabled = false
local noclipConnection = nil
local NOCLIP_JITTER = 0.05

local function setNoclip(on)
    noclipEnabled = on and true or false
    if noclipConnection then
        pcall(function() noclipConnection:Disconnect() end)
        noclipConnection = nil
    end
    if not noclipEnabled then
        -- restore collide on body parts
        pcall(function()
            local char = Player.Character
            if not char then return end
            for _, v in pairs(char:GetDescendants()) do
                if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
                    v.CanCollide = true
                end
            end
        end)
        return
    end
    -- Stepped: force CanCollide false every physics step (no jitter / no CFrame rewrite)
    noclipConnection = RunService.Stepped:Connect(function()
        if unloaded or not noclipEnabled then return end
        pcall(function()
            local char = Player.Character
            if not char then return end
            for _, v in pairs(char:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.CanCollide = false
                end
            end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end
        end)
    end)
end


