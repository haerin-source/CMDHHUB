local specterEspOn = false
local specterEspMap = {}

local function clearSpecterEsp()
    for m, e in pairs(specterEspMap) do
        pcall(function()
            if e.highlight then e.highlight:Destroy() end
            if e.billboard then e.billboard:Destroy() end
        end)
        specterEspMap[m] = nil
    end
end

local function addSpecterEsp(model)
    if specterEspMap[model] then return end
    local root = model:FindFirstChild("HumanoidRootPart")
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    local h = Instance.new("Highlight")
    h.Name = "CMDH_SpecterESP"
    h.Adornee = model
    h.FillColor = Color3.fromRGB(180, 80, 255)
    h.OutlineColor = Color3.fromRGB(220, 160, 255)
    h.FillTransparency = 0.6
    h.Parent = model
    local bb = Instance.new("BillboardGui")
    bb.Name = "CMDH_SpecterESP_BB"
    bb.Adornee = root
    bb.Size = UDim2.new(0, 140, 0, 36)
    bb.AlwaysOnTop = true
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.Parent = root
    local tl = Instance.new("TextLabel")
    tl.Size = UDim2.new(1, 0, 1, 0)
    tl.BackgroundTransparency = 1
    tl.TextColor3 = Color3.fromRGB(220, 160, 255)
    tl.TextStrokeTransparency = 0.4
    tl.TextScaled = true
    tl.Font = Enum.Font.Code
    tl.Text = model.Name
    tl.Parent = bb
    specterEspMap[model] = { highlight = h, billboard = bb, label = tl, root = root, humanoid = hum }
end

task.spawn(function()
    while not unloaded do
        if not specterEspOn then
            task.wait(0.5)
        else
            local living = workspace:FindFirstChild("Living")
            local my = select(1, getHRP())
            if living then
                local seen = {}
                for _, m in ipairs(living:GetChildren()) do
                    if isSpecterName(m.Name) and not isPlayerChar(m) then
                        local hum = m:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Health > 0 then
                            seen[m] = true
                            addSpecterEsp(m)
                        end
                    end
                end
                for m, e in pairs(specterEspMap) do
                    if not seen[m] or not m.Parent then
                        pcall(function()
                            if e.highlight then e.highlight:Destroy() end
                            if e.billboard then e.billboard:Destroy() end
                        end)
                        specterEspMap[m] = nil
                    elseif e.label and e.root and my then
                        local d = math.floor((my.Position - e.root.Position).Magnitude)
                        local hp = e.humanoid and math.floor(e.humanoid.Health) or 0
                        local mx = e.humanoid and math.floor(e.humanoid.MaxHealth) or 0
                        e.label.Text = string.format("%s\n%d/%d | %dm", m.Name, hp, mx, d)
                    end
                end
            end
            task.wait(0.35)
        end
    end
end)

