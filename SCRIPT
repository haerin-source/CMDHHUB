local function priorityText()
    if #selectedMobs == 0 then return "Priority: (none)" end
    local parts = {}
    for i, n in ipairs(selectedMobs) do
        parts[#parts + 1] = i .. "." .. n
    end
    return "Priority: " .. table.concat(parts, " > ")
end

local prioLabel = MobFarmGroup:AddLabel(priorityText())

local function toggleMobPriority(name)
    if not name or name == "(no mobs yet)" then return end
    for i, n in ipairs(selectedMobs) do
        if n == name then
            table.remove(selectedMobs, i)
            pcall(function() prioLabel:SetText(priorityText()) end)
            notify("Farm", "Removed " .. name)
            return
        end
    end
