local function redeemCode(c)
    local ok, res = pcall(function()
        local events = game:GetService("ReplicatedStorage"):FindFirstChild("events")
        if not events then
            events = game:GetService("ReplicatedStorage"):WaitForChild("events", 5)
        end
        local rf = events and (events:FindFirstChild("InsertCode") or events:WaitForChild("InsertCode", 5))
        if not rf then error("InsertCode missing") end
        if rf:IsA("RemoteFunction") then
            return rf:InvokeServer(c)
        end
        if rf:IsA("RemoteEvent") then
            rf:FireServer(c)
            return "fired"
        end
        error("InsertCode bad type")
    end)
    if ok then
        notify("Codes", tostring(c) .. " ok")
    else
        notify("Codes", "fail: " .. tostring(c))
    end
end
