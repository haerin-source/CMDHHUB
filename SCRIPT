local function robustClick(btn)
    if not btn then return false end
    local ok = false
    pcall(function()
        if typeof(getconnections) == "function" then
            for _, sig in ipairs({ "Activated", "MouseButton1Click", "MouseButton1Down" }) do
                local ev = btn[sig]
                if ev then
                    for _, c in ipairs(getconnections(ev)) do
                        pcall(function()
                            if c.Fire then c:Fire() elseif c.Function then c.Function() end
                        end)
                        ok = true
                    end
                end
            end
        end
    end)
    pcall(function()
        if typeof(firesignal) == "function" and btn.MouseButton1Click then
            firesignal(btn.MouseButton1Click)
            ok = true
        end
    end)
    pcall(function()
        local vim = virtualInputManager or game:GetService("VirtualInputManager")
        local GuiService = game:GetService("GuiService")
        local inset = GuiService:GetGuiInset()
        local pos = btn.AbsolutePosition
        local size = btn.AbsoluteSize
        local x = pos.X + size.X / 2 + inset.X
        local y = pos.Y + size.Y / 2 + inset.Y
        vim:SendMouseMoveEvent(x, y, game)
        task.wait(0.01)
        vim:SendMouseButtonEvent(x, y, 0, true, game, 1)
        task.wait(0.02)
        vim:SendMouseButtonEvent(x, y, 0, false, game, 1)
        ok = true
    end)
    return ok
end

