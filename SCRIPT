local AIR_SKIP_Y = 5 -- mob feet farther than this above their own floor → airborne

local function isZombieDevil(modelOrRoot)
    local m = modelOrRoot
    if m and m:IsA("BasePart") then m = m.Parent end
    if not m then return false end
    local n = m.Name or ""
    return n == "Zombie Devil" or n:gsub("%s+", "") == "ZombieDevil"
end

-- ground filter: airborne skipped, EXCEPT Zombie Devil (Y allowed)
local function isMobOnGround(root)
    if not root then return false end
    if isZombieDevil(root) then return true end
    local hrp = select(1, getHRP())
    if not hrp then return false end
    local pos = root.Position
    local dy = pos.Y - hrp.Position.Y
    if dy > AIR_SKIP_Y or dy < -25 then
        return false
    end
    local ok, res = pcall(function()
        return workspace:Raycast(pos + Vector3.new(0, 2, 0), Vector3.new(0, -25, 0))
    end)
    if not ok or not res then
        return false
    end
    if (pos.Y - res.Position.Y) > 8 then
        return false
    end
    return true
end

local function attackOffsetPos(targetRoot)
    if not targetRoot then return nil end
    if not isMobOnGround(targetRoot) then return nil end
    if isZombieDevil(targetRoot) then return nil end -- devil uses its own approach
    local hrp = select(1, getHRP())
    if not hrp then return nil end
    local look = targetRoot.CFrame.LookVector
    local pos = targetRoot.Position
    -- stand at MOB height (same floor) — no surface ratchet / sky drift
    local lockY = pos.Y
    local flat = Vector3.new(look.X, 0, look.Z)
    local behind
    if flat.Magnitude > 0.05 then
        behind = pos - flat.Unit * (atkBehind or 4)
    else
        behind = pos - Vector3.new(0, 0, atkBehind or 4)
    end
    return Vector3.new(behind.X, lockY, behind.Z)
end

-- Early-style R5 Zombie Devil: step behind + face, no long lerp (no map-end overshoot)
local function approachDevil(targetRoot)
    local hrp = select(1, getHRP())
    if not hrp or not targetRoot then return end
    local pos = targetRoot.Position
    local look = targetRoot.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    local behind
    if flat.Magnitude > 0.05 then
        behind = pos - flat.Unit * (atkBehind or 4)
    else
        behind = pos - Vector3.new(0, 0, atkBehind or 4)
    end
    -- keep same height band as devil (slightly below chest), not map-edge Y
    behind = Vector3.new(behind.X, pos.Y, behind.Z)
    local to = behind - hrp.Position
    local dist = to.Magnitude
    local step = math.min(dist, math.max(MOVE_SPEED * 0.04, 2))
    local newPos = hrp.Position
    if dist > 2.5 then
        newPos = hrp.Position + to.Unit * step
    else
        newPos = behind
    end
    pcall(function()
        hrp.AssemblyLinearVelocity = Vector3.zero
        -- face the devil body
        if (pos - newPos).Magnitude > 0.1 then
            hrp.CFrame = CFrame.lookAt(newPos, pos)
        else
            hrp.CFrame = CFrame.new(newPos)
        end
    end)
end

local function approachMob(targetRoot)
    if not targetRoot then return end
    if not isMobOnGround(targetRoot) then return end
    if isZombieDevil(targetRoot) then
        approachDevil(targetRoot)
        return
    end
    local dest = attackOffsetPos(targetRoot)
    if not dest then return end
    local lookTarget = Vector3.new(targetRoot.Position.X, dest.Y, targetRoot.Position.Z)
    cframeFlyTo(dest, lookTarget, false)
end

