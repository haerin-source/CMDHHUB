    -- polyfill GetMouse if stripped (some executors)
    pcall(function()
        local lp = Players.LocalPlayer
        if lp and type(lp.GetMouse) ~= "function" then
            -- leave as-is; Linoria may error — we catch
        end
    end)
    local urls = {
        REPO .. path,
        REPO_FALLBACK .. path,
    }
    for _, url in ipairs(urls) do
        local okGet, body = pcall(function()
            return game:HttpGet(url)
        end)
        if not okGet or type(body) ~= "string" or #body < 100 or body:find("^%s*<") then
            bootLog("HttpGet fail", path, tostring(body):sub(1, 40))
        else
            local chunkName = "CMDH_" .. path:gsub("[%W]", "_")
            local okLoad, fn = pcall(function()
                return loadstring(body, chunkName)
            end)
            if not okLoad or type(fn) ~= "function" then
                bootLog("loadstring fail", path, tostring(fn))
            else
                local okRun, lib = pcall(fn)
                if okRun and lib ~= nil then
                    return lib
                end
                bootLog("run fail", path, tostring(lib))
            end
        end
    end
    return nil
end

