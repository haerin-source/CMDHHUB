local PathfindingService = game:GetService("PathfindingService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PostSimulation = RunService.PostSimulation

local farmToggle = false
local raidFarmOn = false
local raidHealing = false
local selectedMobs = {} -- priority ordered: [1]=highest
local MOVE_SPEED = 150 -- default speed
local atkBehind = 4
local atkAbove = 3
local atkBelow = 3
local skyHover = 28
local skyWait = 0.35
-- hunt styles priority (click add/remove): "Behind", "Above", "Below"
local huntModes = { "Behind" } -- behind-only attack
local busyQuestMove = false

local function getHRP()
    local c = Player.Character
    return c and c:FindFirstChild("HumanoidRootPart"), c
end

local function cframeFlyTo(target)
    if typeof(target) == "CFrame" then
        target = target.Position
    end
    local hrp = select(1, getHRP())
    if not hrp then return end
    local startPos = hrp.Position
    local delta = target - startPos
    local dist = delta.Magnitude
    if dist < 1.5 then
        hrp.CFrame = CFrame.new(target)
        return
    end
    local duration = dist / MOVE_SPEED
    local t0 = tick()
    repeat
        if not farmToggle and not raidFarmOn then break end
        if not hrp.Parent then break end
        PostSimulation:Wait()
        local alpha = math.min((tick() - t0) / math.max(duration, 0.01), 1)
        local pos = startPos + delta * alpha
        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.CFrame = CFrame.new(pos)
        end)
    until alpha >= 1 or (hrp.Position - target).Magnitude <= math.max(MOVE_SPEED * 0.05, 2)
    if hrp and hrp.Parent then
        hrp.CFrame = CFrame.new(target)
    end
end

local function pathFlyTo(targetPos)
    -- direct fly, no sky hover
    cframeFlyTo(targetPos)
end

local function hasHunt(mode)
    for _, m in ipairs(huntModes) do
        if m == mode then return true end
    end
    return false
end

local function attackOffsetPos(targetRoot)
    if not targetRoot then return nil end
    -- Behind-only: stand behind the target facing them
    local look = targetRoot.CFrame.LookVector
    local pos = targetRoot.Position
    local off = -look * (atkBehind or 4)
    return pos + off
end

local function approachMob(targetRoot)
    if not targetRoot then return end
    -- direct behind the mob — no sky hover / wait
    local dest = attackOffsetPos(targetRoot)
    if dest then
        cframeFlyTo(dest)
    end
end

local function isPlayerChar(model)
    return Players:GetPlayerFromCharacter(model) ~= nil
end

local function uniqueNames(list)
    local seen, out = {}, {}
    for _, n in ipairs(list) do
        if not seen[n] then
            seen[n] = true
            table.insert(out, n)
        end
    end
    table.sort(out)
    return out
end

local function collectMobNames()
    local names = {}
    local living = workspace:FindFirstChild("Living")
    if living then
        for _, m in ipairs(living:GetChildren()) do
            if m:IsA("Model") and not isPlayerChar(m) then
                table.insert(names, m.Name)
            end
        end
    end
    return uniqueNames(names)
end

local function doAttack()
    pcall(function()
        ReplicatedStorage.events.remote:FireServer("NormalAttack")
    end)
end

local function farmOne(model)
    local hrp = model:FindFirstChild("HumanoidRootPart")
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    while (farmToggle or raidFarmOn) and hum.Parent and hum.Health > 0 do
        if not farmToggle and not raidFarmOn then break end
        approachMob(hrp)
        doAttack()
        task.wait()
    end
end

local function pickPriorityTarget()
    local living = workspace:FindFirstChild("Living")
    local myHrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    if not living or #selectedMobs == 0 then return nil end
    -- priority name first; within same name pick nearest
    for _, mobName in ipairs(selectedMobs) do
        local best, bestD = nil, math.huge
        for _, child in ipairs(living:GetChildren()) do
            if child.Name == mobName and not isPlayerChar(child) then
                local hum = child:FindFirstChildOfClass("Humanoid")
                local root = child:FindFirstChild("HumanoidRootPart")
                if hum and root and hum.Health > 0 then
                    local d = 0
                    if myHrp then
                        d = (myHrp.Position - root.Position).Magnitude
                    end
                    if d < bestD then
                        best, bestD = child, d
                    end
                end
            end
        end
        if best then return best end
    end
    return nil
end

task.spawn(function()
    while not unloaded do
        if farmToggle and #selectedMobs > 0 then
            local target = pickPriorityTarget()
            if target then
                farmOne(target)
            end
        end
        task.wait(0.35)
    end
end)

