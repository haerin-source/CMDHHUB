        notify("Codes", "fail: " .. tostring(c))
    end
end
local function copyCode(c)
    redeemCode(c)
end

local redeemBusy = false
local function redeemAllIn(list, label)
    if redeemBusy then
        notify("Codes", "already redeeming")
        return
    end
    redeemBusy = true
    task.spawn(function()
        local okN, failN = 0, 0
        notify("Codes", "Redeem all " .. label .. " (" .. #list .. ")")
        for _, c in ipairs(list) do
            if unloaded then break end
            local ok = pcall(function()
                local events = game:GetService("ReplicatedStorage"):FindFirstChild("events")
                    or game:GetService("ReplicatedStorage"):WaitForChild("events", 5)
                local rf = events and (events:FindFirstChild("InsertCode") or events:WaitForChild("InsertCode", 5))
                if not rf then error("InsertCode missing") end
                if rf:IsA("RemoteFunction") then
                    rf:InvokeServer(c)
                elseif rf:IsA("RemoteEvent") then
                    rf:FireServer(c)
                else
                    error("bad remote")
                end
            end)
            if ok then okN = okN + 1 else failN = failN + 1 end
            task.wait(0.35)
        end
        redeemBusy = false
        notify("Codes", label .. " done ok=" .. okN .. " fail=" .. failN)
    end)
end

