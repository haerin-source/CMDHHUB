    return CFrame.new(pos)
end

-- snap Y to surface under a point (never climb into sky)
local function surfaceY(xz, maxUp)
    maxUp = maxUp or 6
    local origin = Vector3.new(xz.X, xz.Y + maxUp, xz.Z)
    local ok, res = pcall(function()
        return workspace:Raycast(origin, Vector3.new(0, -(maxUp + 40), 0))
    end)
    if ok and res then
        return res.Position.Y + 3
    end
    return xz.Y -- keep current, do not invent a higher Y
end

local function cframeFlyTo(target, lookAt, allowY)
    if typeof(target) == "CFrame" then
        target = target.Position
    end
    local hrp = select(1, getHRP())
    if not hrp then return end
    local startPos, dist, delta
    if allowY then
        -- full 3D path (Zombie Devil only)
        startPos = hrp.Position
        delta = target - startPos
        dist = delta.Magnitude
    else
        -- XZ move; Y lerps to target.Y (mob height) so we don't sit in the sky
        local lockY = target.Y
        startPos = hrp.Position
        -- if we're way above target, snap Y down fast first (anti sky-hit)
        if startPos.Y > lockY + 8 then
            startPos = Vector3.new(startPos.X, lockY, startPos.Z)
            pcall(function()
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.CFrame = faceAt(hrp, startPos, lookAt and Vector3.new(lookAt.X, lockY, lookAt.Z) or nil)
            end)
        end
        target = Vector3.new(target.X, lockY, target.Z)
        if lookAt then
            lookAt = Vector3.new(lookAt.X, lockY, lookAt.Z)
        end
        delta = target - startPos
        dist = Vector3.new(delta.X, 0, delta.Z).Magnitude
        -- include small Y in path so we settle to mob height
        if math.abs(delta.Y) > 0.5 then
            dist = dist + math.abs(delta.Y) * 0.35
        end
    end
    if dist < 1.5 then
        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.CFrame = faceAt(hrp, allowY and target or startPos, lookAt)
        end)
        return
    end
    local duration = dist / MOVE_SPEED
    local t0 = tick()
    repeat
        if not farmToggle and not raidFarmOn and not specterFarmOn and not allFiendFarmOn then break end
        if not hrp.Parent then break end
        PostSimulation:Wait()
        local alpha = math.min((tick() - t0) / math.max(duration, 0.01), 1)
        local pos = startPos + delta * alpha
        if not allowY then
            -- XZ from path; Y eases to mob height
            pos = Vector3.new(pos.X, startPos.Y + (target.Y - startPos.Y) * alpha, pos.Z)
        end
        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.CFrame = faceAt(hrp, pos, lookAt)
        end)
    until alpha >= 1 or (hrp.Position - target).Magnitude <= math.max(MOVE_SPEED * 0.05, 2)
    -- if farm was turned OFF mid-path: stop in place, never finish teleport to target
    local gateOn = farmToggle or raidFarmOn or specterFarmOn or allFiendFarmOn
    if hrp and hrp.Parent and gateOn then
        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.zero
            local final = allowY and target or Vector3.new(target.X, target.Y, target.Z)
            hrp.CFrame = faceAt(hrp, final, lookAt)
        end)
    else
        pcall(function()
            if hrp then hrp.AssemblyLinearVelocity = Vector3.zero end
        end)
    end
end

local function pathFlyTo(targetPos)
    -- direct fly, no sky hover
    cframeFlyTo(targetPos)
end

