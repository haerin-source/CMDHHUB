local function isReadyUpText(tx)
    tx = tostring(tx or "")
    local low = string.lower(tx)
    -- EN
    if low:find("ready up", 1, true) or low:find("readyup", 1, true) then return true end
    -- KR (screenshot: 준비 완료)
    if tx:find("준비 완료", 1, true) or tx:find("준비완료", 1, true) then return true end
    if low:find("junbi") then return true end -- rare romanization
    return false
end

local function findReadyUpButton(parent)
    if not parent then return nil end
    local ok, children = pcall(function() return parent:GetChildren() end)
    if not ok or not children then return nil end
    for _, child in ipairs(children) do
        local isBtn = child:IsA("TextButton") or child:IsA("TextLabel")
        if isBtn then
            local tx = ""
            pcall(function() tx = tostring(child.Text or "") end)
            if isReadyUpText(tx) then
                -- never click "Main Game" / "메인 게임"
                if child:IsA("TextLabel") and child.Parent and child.Parent:IsA("TextButton") then
                    return child.Parent
                end
                if child:IsA("TextButton") then return child end
                if child.Parent and child.Parent:IsA("TextButton") then return child.Parent end
            end
        end
        local found = findReadyUpButton(child)
        if found then return found end
    end
    return nil
end

local function fireReadyConnections(btn)
    if not btn or not btn:IsA("GuiButton") then return false end
    local ok = false
    pcall(function()
        if typeof(getconnections) ~= "function" then return end
        for _, sig in ipairs({ "MouseButton1Click", "Activated", "MouseButton1Down" }) do
            local ev = btn[sig]
            if ev then
                for _, c in ipairs(getconnections(ev)) do
                    pcall(function()
                        if c.Fire then c:Fire() elseif c.Function then c.Function() end
                    end)
                    ok = true
                end
            end
        end
    end)
    return ok
end

-- tryReadyUp: NO Visible check (unfocused Roblox often keeps Visible=false)
-- Prefer getconnections only — mouse/VIM fails when window not focused
local function tryReadyUp()
    if not autoReadyUp then return false end
    if raidMode == "Makima" then return false end
    local pg = Player:FindFirstChild("PlayerGui")
    if not pg then return false end
    local targetButton = findReadyUpButton(pg)
    if not targetButton then return false end
    if fireReadyConnections(targetButton) then
        return true
    end
    -- last resort mouse click (works only if window focused)
    return robustClick(targetButton)
end

-- burst fire several times (UI connections sometimes attach late when unfocused)
local function burstReadyUp(times)
    times = times or 5
    local ok = false
    for _ = 1, times do
        if tryReadyUp() then ok = true end
        task.wait(0.12)
    end
    return ok
end

