-- never rely on warn/print being intact
local function bootLog(...)
    local msg = ""
    local n = select("#", ...)
    for i = 1, n do
        if i > 1 then msg = msg .. " " end
        msg = msg .. tostring(select(i, ...))
    end
    pcall(function() print("[CMDH] " .. msg) end)
    pcall(function()
        if type(warn) == "function" then warn("[CMDH] " .. msg) end
    end)
end

