local PLACE_ID = 11345435986
if game.PlaceId ~= PLACE_ID then
    warn("[CMDH] wrong game PlaceId=" .. tostring(game.PlaceId) .. " need " .. PLACE_ID)
    return
end

-- Single-instance: if already running, kill the live copy first then continue
do
    local g = (type(getgenv) == "function" and getgenv()) or _G
    if g.CMDH_DEVILHEART_RUNNING and type(g.DevilHeartUnload) == "function" then
        warn("[CMDH] previous instance live — unloading it")
        pcall(g.DevilHeartUnload)
        task.wait(0.35)
    end
    g.CMDH_DEVILHEART_RUNNING = true
end

-- Safe _G API stubs (prevents nil.SetEnabled / IsRedirectEnabled)
do
    local function ensure(name)
        local api = rawget(_G, name)
        if type(api) ~= "table" then
            api = {}
            _G[name] = api
        end
        return api
    end
    local function noop() end
    local function nofalse() return false end
    local function empty() return {} end
    for _, name in ipairs({
        "AutoParryAPI",
        "AutoParryProjectileAPI",
        "PlayerEspAPI",
        "NPCEspAPI",
        "RunBoostAPI",
        "DevilHeartTracker",
    }) do
        local api = ensure(name)
        for _, meth in ipairs({
            "SetEnabled", "IsEnabled", "SetRedirectEnabled", "IsRedirectEnabled",
            "SetAutoParry", "SetParryKick", "SetCameraOffset", "SetReactionDisabled",
            "SetReactionAutoAttack", "ActivateLock", "DeactivateLock", "KeyAction",
            "GetEditableReactionIds",
        }) do
            if type(api[meth]) ~= "function" then
                if meth:sub(1, 2) == "Is" then
                    api[meth] = nofalse
                elseif meth:sub(1, 3) == "Get" then
                    api[meth] = empty
                else
                    api[meth] = noop
                end
            end
        end
    end
    if type(_G.DevilHeartTracker) == "table" and _G.DevilHeartTracker.hasHeart == nil then
        _G.DevilHeartTracker.hasHeart = false
    end
end


