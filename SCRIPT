local function heartOk()
    local t = _G.DevilHeartTracker
    return t and t.hasHeart
end

local function fetchServers(cursor)
    local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    if cursor then url = url .. "&cursor=" .. cursor end
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if not ok or not body then return nil end
    local ok2, data = pcall(function() return HttpService:JSONDecode(body) end)
    if not ok2 then return nil end
    return data
end

local function collectCandidates(pagesMax)
    local cursor, candidates, pages = nil, {}, 0
    pagesMax = pagesMax or 8
    while pages < pagesMax and not unloaded do
        local data = fetchServers(cursor)
        if not data or type(data.data) ~= "table" then break end
        for _, srv in ipairs(data.data) do
            if type(srv) == "table" and type(srv.id) == "string" and srv.id ~= "" and srv.id ~= JobId
                and type(srv.playing) == "number" and type(srv.maxPlayers) == "number"
                and srv.playing < srv.maxPlayers
                and srv.playing >= hopMinPlayers and srv.playing <= hopMaxPlayers then
                table.insert(candidates, srv)
            end
        end
        cursor = data.nextPageCursor
        pages = pages + 1
        if not cursor or cursor == "" then break end
        task.wait(0.12)
    end
    return candidates
end

-- mode: "random" | "lowest" | "ping"
local function serverHop(mode)
    if hopInProgress or unloaded then return end
    hopInProgress = true
    mode = mode or "random"
    notify("Hop", "Searching (" .. mode .. ")...")
    task.spawn(function()
        local candidates = collectCandidates(8)
        if #candidates == 0 then
            notify("Hop", "No other server in range")
            hopInProgress = false
            return
        end
        if mode == "lowest" then
            table.sort(candidates, function(a, b)
                if a.playing == b.playing then
                    return (a.ping or 9999) < (b.ping or 9999)
                end
                return a.playing < b.playing
            end)
        elseif mode == "ping" then
            table.sort(candidates, function(a, b)
                local pa = (type(a.ping) == "number" and a.ping) or 9999
                local pb = (type(b.ping) == "number" and b.ping) or 9999
                if pa == pb then return a.playing < b.playing end
                return pa < pb
            end)
        else
            -- random shuffle, never current (already filtered)
            for i = #candidates, 2, -1 do
                local j = math.random(i)
                candidates[i], candidates[j] = candidates[j], candidates[i]
            end
        end
        -- try up to 5 different job ids (skip if somehow current)
        local tried = 0
        for _, t in ipairs(candidates) do
            if t.id ~= JobId then
                tried = tried + 1
                notify("Hop", string.format("%s → %d/%d pl | ping %s", mode, t.playing, t.maxPlayers, tostring(t.ping or "?")))
                local ok = pcall(function()
                    TeleportService:TeleportToPlaceInstance(PlaceId, t.id, Player)
                end)
                if ok then
                    hopInProgress = false
                    return
                end
                if tried >= 5 then break end
                task.wait(0.4)
            end
        end
        notify("Hop", "Teleport failed")
        hopInProgress = false
    end)
end

