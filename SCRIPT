local function destroyEntry(entry)
    if entry and entry.bb then pcall(function() entry.bb:Destroy() end) end
end

local function clearMap(map)
    for k, e in pairs(map) do
        destroyEntry(e)
        map[k] = nil
    end
end

local function makeLabel(model, color)
    local root = model:FindFirstChild("HumanoidRootPart")
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return nil end
    local bb = Instance.new("BillboardGui")
    bb.Name = "SPLIT_NPC_ESP"
    bb.AlwaysOnTop = true
    bb.Size = UDim2.new(0, 120, 0, 30)
    bb.StudsOffset = Vector3.new(0, 4, 0)
    bb.Adornee = root
    bb.Parent = model
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = color
    label.TextStrokeTransparency = 0.5
    label.Font = Enum.Font.GothamBold
    label.TextScaled = true
    label.Parent = bb
    return { bb = bb, label = label, humanoid = hum }
end

local function isMut(model)
    local root = model:FindFirstChild("HumanoidRootPart")
    return root and root:FindFirstChildWhichIsA("ParticleEmitter") ~= nil
end

local function addFiend(model)
    if not model:IsA("Model") or fiendMap[model] then return end
    if not string.find(model.Name, "Fiend") then return end
    local col = isMut(model) and COLOR_MUT or COLOR_NPC
    local e = makeLabel(model, col)
    if e then fiendMap[model] = e end
end

local function addDevil(model)
    if not model:IsA("Model") or devilMap[model] then return end
    if not string.find(model.Name, "Devil") then return end
    if string.find(model.Name, "Fiend") then return end
    local col = isMut(model) and COLOR_MUT or COLOR_NPC
    local e = makeLabel(model, col)
    if e then devilMap[model] = e end
end

