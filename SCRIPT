local function getRaidHintText()
    local pg = Player:FindFirstChild("PlayerGui")
    if not pg then return "" end
    local guis = pg:FindFirstChild("guis")
    local hint = guis and guis:FindFirstChild("RaidHint")
    if hint and hint:IsA("TextLabel") then
        return hint.Text or ""
    end
    local h = pg:FindFirstChild("RaidHint", true)
    if h and h:IsA("TextLabel") then return h.Text or "" end
    return ""
end

local function isWave5()
    local tx = getRaidHintText()
    if tx:match("Wave:%s*5") or tx:match("[Ww]ave%s*5") then return true end
    if tx:lower():find("zombie devil") then return true end
    return false
end

local function mobNameMatch(modelName, aliases)
    if type(aliases) == "string" then
        aliases = { aliases }
    end
    local compact = modelName:gsub("%s+", "")
    for _, a in ipairs(aliases) do
        if modelName == a then return true end
        if compact == a:gsub("%s+", "") then return true end
    end
    return false
end

-- Mention raid: wave fiends → Neon Hunter → Sideburns Guy
local MENTION_WAVE = {
    "FlyFiend", "Fly Fiend",
    "Mannequin Fiend", "MannequinFiend",
    "Mantis Fiend", "MantisFiend",
    "Toxin Fiend", "ToxinFiend",
    "Wasp Fiend", "WaspFiend",
}
local MENTION_KILL_TARGET = {
    Normal = 11,
    Hard = 14,
    Insane = 18,
}
local MENTION_SPOT = CFrame.new(
    1027.09949, 1661.1665, -825.437988,
    0.117095001, -9.35168245e-08, -0.99312073,
    -3.89199926e-08, 1, -9.87535174e-08,
    0.99312073, 5.02157924e-08, 0.117095001
)
local mentionKills = 0
local mentionPhase = "wave" -- wave | neon | guy

local function isMentionWaveName(name)
    local n = tostring(name or "")
    local compact = n:gsub("%s+", ""):lower()
    for _, a in ipairs(MENTION_WAVE) do
        if n == a or compact == a:gsub("%s+", ""):lower() then return true end
        if compact:find("fiend") and (
            compact:find("fly") or compact:find("mannequin") or compact:find("mantis")
            or compact:find("toxin") or compact:find("wasp")
        ) then return true end
    end
    return false
end

local function isNeonHunter(name)
    local n = tostring(name or ""):gsub("%s+", ""):lower()
    return n == "neonhunter" or n:find("neonhunter") ~= nil
end

local function isSideburnsGuy(name)
    local n = tostring(name or ""):gsub("%s+", ""):lower()
    return n:find("sideburns") ~= nil or n == "sideburnsguy" or n:find("sideburn") ~= nil
end

local function getRaidPriorityAliases()
    if raidMode == "Makima" then
        return MAKIMA_PRIO
    end
    if raidMode == "Mention" then
        if mentionPhase == "guy" then
            return { { "Sideburns Guy", "SideburnsGuy", "Sideburns" } }
        end
        if mentionPhase == "neon" then
            return { { "Neon Hunter", "NeonHunter" } }
        end
        -- wave: any of the five fiends (flat list of alias groups, nearest overall handled in pick)
        return {
            { "FlyFiend", "Fly Fiend" },
            { "Mannequin Fiend", "MannequinFiend" },
            { "Mantis Fiend", "MantisFiend" },
            { "Toxin Fiend", "ToxinFiend" },
            { "Wasp Fiend", "WaspFiend" },
        }
    end
    local list = isWave5() and ZOMBIE_PRIO_WAVE5 or ZOMBIE_PRIO_NORMAL
    local out = {}
    for _, n in ipairs(list) do
        out[#out + 1] = { n }
    end
    return out
end

local function getMyHumanoid()
    local c = Player.Character
    return c and c:FindFirstChildOfClass("Humanoid"), c
end

local function raidPickTarget()
    local living = workspace:FindFirstChild("Living")
    if not living then return nil end
    local my = select(1, getHRP())

    if raidMode == "Mention" then
        local need = MENTION_KILL_TARGET[raidDifficulty] or 11
        -- phase advance
        if mentionPhase == "wave" and mentionKills >= need then
            mentionPhase = "neon"
        end
        -- if neon dead / gone and guy exists → guy
        if mentionPhase == "neon" or mentionPhase == "guy" then
            local guy, neon = nil, nil
            for _, m in ipairs(living:GetChildren()) do
                if not isPlayerChar(m) then
                    local hum = m:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        if isSideburnsGuy(m.Name) then guy = m end
                        if isNeonHunter(m.Name) then neon = m end
                    end
                end
            end
            if guy then
                mentionPhase = "guy"
                return guy
            end
            if neon then
                mentionPhase = "neon"
                return neon
            end
            -- wait at spot for neon/guy
            return nil
        end
        -- wave: nearest matching fiend
        local best, bestD = nil, math.huge
        for _, m in ipairs(living:GetChildren()) do
            if not isPlayerChar(m) and isMentionWaveName(m.Name) then
                local hum = m:FindFirstChildOfClass("Humanoid")
                local root = m:FindFirstChild("HumanoidRootPart")
                if hum and root and hum.Health > 0 and isMobOnGround(root) then
                    local d = my and (my.Position - root.Position).Magnitude or 0
                    if d < bestD then best, bestD = m, d end
                end
            end
        end
        return best
    end

    local prio = getRaidPriorityAliases()
    for _, aliases in ipairs(prio) do
        local best, bestD = nil, math.huge
        for _, m in ipairs(living:GetChildren()) do
            if not isPlayerChar(m) and mobNameMatch(m.Name, aliases) then
                local hum = m:FindFirstChildOfClass("Humanoid")
                local root = m:FindFirstChild("HumanoidRootPart")
                if hum and root and hum.Health > 0 and isMobOnGround(root) then
                    local d = 0
                    if my then d = (my.Position - root.Position).Magnitude end
                    if d < bestD then
                        best, bestD = m, d
                    end
                end
            end
        end
        if best then return best end
    end
    return nil
end

-- Raid: pure kill loop — fast retarget (no empty-spot linger)
task.spawn(function()
    while not unloaded do
        if not raidFarmOn then
            task.wait(0.35)
        else
            MOVE_SPEED = 40
            if raidMode == "Mention" and mentionPhase ~= "wave" then
                -- stand on mention spot while waiting/fighting neon/guy
                local hrp = select(1, getHRP())
                if hrp then
                    local dest = MENTION_SPOT.Position
                    local d = (hrp.Position - dest).Magnitude
                    if d > 6 then
                        pcall(function()
                            hrp.AssemblyLinearVelocity = Vector3.zero
                            hrp.CFrame = CFrame.new(dest) * (MENTION_SPOT - MENTION_SPOT.Position)
                        end)
                        -- safer: full CFrame
                        pcall(function() hrp.CFrame = MENTION_SPOT end)
                    end
                end
            end
            local target = raidPickTarget()
            if target then
                local hum = target:FindFirstChildOfClass("Humanoid")
                local hpBefore = hum and hum.Health or 0
                farmOne(target)
                -- count wave kills for Mention
                if raidMode == "Mention" and mentionPhase == "wave" and hum then
                    if not hum.Parent or hum.Health <= 0 or hum.Health < hpBefore then
                        if not hum.Parent or hum.Health <= 0 then
                            mentionKills = mentionKills + 1
                        end
                    end
                end
            else
                task.wait(0.05)
            end
            task.wait(0.03)
        end
    end
end)

