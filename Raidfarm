            clickReadyUp()
        end
        task.wait(0.4)
    end
end)

task.spawn(function()
    while not S.unloaded and GEN.CMDH_RAIDFARM_RUNNING do
        if S.farmOn then
            local phase = raidPhase()
            if phase and phase ~= "ready" then
                local t = pickTarget()
                if t then farmOne(t) end
            end
            task.wait(0.12)
        else
            task.wait(0.3)
        end
    end
end)

