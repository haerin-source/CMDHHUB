local function getHRP()
    local c = Player.Character
    if not c then return nil end
    return c:FindFirstChild("HumanoidRootPart"), c:FindFirstChildOfClass("Humanoid")
end

local function getRaidHintText()
    local pg = Player:FindFirstChild("PlayerGui")
    if not pg then return "" end
    local guis = pg:FindFirstChild("guis")
    local hint = guis and guis:FindFirstChild("RaidHint")
    if hint and (hint:IsA("TextLabel") or hint:IsA("TextButton")) then
        return hint.Text or ""
    end
    local h = pg:FindFirstChild("RaidHint", true)
    if h and (h:IsA("TextLabel") or h:IsA("TextButton")) then return h.Text or "" end
    return ""
end

local function raidPhase()
    local tx = getRaidHintText()
    if tx == "" then return nil, tx end
    if tx:match("Wave:%s*%d+") then return "wave", tx end
    if tx:match("the fiends%.") then return "fiends", tx end
    if tx:match("Meet the neon hunter%.") then return "neon_meet", tx end
    if tx:match("Finish the neon hunter%.") then return "neon_finish", tx end
    if tx:match("Defeat the weird sideburns guy%.") then return "sideburns", tx end
    local low = string.lower(tx)
    if low:find("ready up", 1, true) then return "ready", tx end
    if low:find("raid completed", 1, true) or tx:find("레이드 완료", 1, true) then return "done", tx end
    if low:find("zombie devil", 1, true) then return "wave5", tx end
    return "active", tx
end

local function isPlayerChar(model)
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character == model then return true end
    end
    return false
end

local function isAliveMob(m)
    if not m or isPlayerChar(m) then return false end
    local hum = m:FindFirstChildOfClass("Humanoid")
    local root = m:FindFirstChild("HumanoidRootPart")
    return hum and root and hum.Health > 0
end

local function nameMatch(modelName, aliases)
    if type(aliases) == "string" then aliases = { aliases } end
    local compact = modelName:gsub("%s+", "")
    for _, a in ipairs(aliases) do
        if modelName == a or compact == a:gsub("%s+", "") then return true end
        if string.lower(modelName):find(string.lower(a), 1, true) then return true end
    end
    return false
end

local ZOMBIE_PRIO = { "Zombie Devil", "Crawler Zombie", "Tank Zombie", "Zombie" }
local MAKIMA_PRIO = {
    { "Longsword User", "LongswordUser" },
    { "Fake Makima", "FakeMakima" },
    { "Makima" },
}
local MENTION_PRIO = {
    "Neon Hunter", "Sideburns", "weird sideburns",
    "FlyFiend", "Fly Fiend", "Mannequin", "Mantis", "Toxin", "Wasp", "Fiend",
}

local function livingFolder()
    return workspace:FindFirstChild("Living") or workspace:FindFirstChild("Monster") or workspace
end

local function pickTarget()
    local folder = livingFolder()
    local my = select(1, getHRP())
    if not folder or not my then return nil end
    local candidates = {}
    for _, m in ipairs(folder:GetChildren()) do
        if isAliveMob(m) then
            table.insert(candidates, m)
        end
    end
    local function bestByList(list)
        for _, entry in ipairs(list) do
            local aliases = type(entry) == "table" and entry or { entry }
            local best, bestD = nil, math.huge
            for _, m in ipairs(candidates) do
                if nameMatch(m.Name, aliases) then
                    local d = (my.Position - m.HumanoidRootPart.Position).Magnitude
                    if d < bestD then best, bestD = m, d end
                end
            end
            if best then return best end
        end
        return nil
    end
    if S.mode == "Makima" then
        return bestByList(MAKIMA_PRIO)
    elseif S.mode == "Mention" then
        return bestByList(MENTION_PRIO) or bestByList({ "Fiend" })
    else
        -- Zombie: wave5 prefer devil
        local tx = getRaidHintText()
        if tx:match("Wave:%s*5") or tx:lower():find("zombie devil") then
            local d = bestByList({ "Zombie Devil" })
            if d then return d end
        end
        return bestByList(ZOMBIE_PRIO)
    end
end

local function behindCF(targetRoot, dist)
    dist = dist or 4
    local look = targetRoot.CFrame.LookVector
    local pos = targetRoot.Position - look * dist + Vector3.new(0, 1.5, 0)
    return CFrame.new(pos, targetRoot.Position)
end

local function attackPulse()
    pcall(function()
        local events = ReplicatedStorage:FindFirstChild("events")
        if not events then return end
        local remote = events:FindFirstChild("remote") or events:FindFirstChild("toolremote")
        -- light M1 via VIM
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
end

local function farmOne(target)
    local root, hum = getHRP()
    if not root or not hum or not target then return end
    local tRoot = target:FindFirstChild("HumanoidRootPart")
    local tHum = target:FindFirstChildOfClass("Humanoid")
    if not tRoot or not tHum or tHum.Health <= 0 then return end
    if hum.Sit then hum.Sit = false end
    -- stick behind + face
    root.CFrame = behindCF(tRoot, 3.5)
    attackPulse()
end

local function clickReadyUp()
    local pg = PlayerGui
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("TextButton") or d:IsA("TextLabel") then
            local t = string.lower(d.Text or "")
            if t:find("ready up", 1, true) and d.Visible ~= false then
                pcall(function()
                    if firesignal then
                        firesignal(d.MouseButton1Click)
                    end
                    VirtualInputManager:SendMouseButtonEvent(
                        d.AbsolutePosition.X + d.AbsoluteSize.X / 2,
                        d.AbsolutePosition.Y + d.AbsoluteSize.Y / 2 + 40,
                        0, true, game, 0
                    )
                    VirtualInputManager:SendMouseButtonEvent(
                        d.AbsolutePosition.X + d.AbsoluteSize.X / 2,
                        d.AbsolutePosition.Y + d.AbsoluteSize.Y / 2 + 40,
                        0, false, game, 0
                    )
                end)
                return true
            end
        end
    end
    return false
end

